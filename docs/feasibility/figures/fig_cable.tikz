  legend pos=south west, title={(a) $V(r)=V_0K_0(r/\lambda)/K_0(a/\lambda)$}]
\addplot table[x=r,y=V0p5] {\dataroot/cable.dat}; \addlegendentry{$\lambda=0{,}5$ m}
