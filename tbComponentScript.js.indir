//tbeditor
function changeMethodServer(editor,args = null) {

    let editorValue = editor.value;

    if (editor.getAttribute("editortype") === "CURRENCY"
            || editor.getAttribute("editortype") === "COMBOBOX")
    {
        let valueElement = document.getElementById(editor.id.replace("_vi", ""));
        if (valueElement)
        {
            editor = valueElement;

        }
    }

    if (editor.getAttribute("editortype") === "CHECKBOX")
    {
        editorValue = editor.checked;

    } else
    {
        editorValue = editor.value;
    }

    let data = {};
    if (editor.id.startsWith("tbGridEdit"))//grids editor
    {
        let grdName = comboGetSegmentByIndex(editor.id, 1);
        var grd = window[grdName];
        if (grd)//grid var ise
        {
            let selectedRowIndex = "row_-1";
            if (grd.getSelectedRow())
                selectedRowIndex = grd.getSelectedRow().id;

            let rowData = grd.getRowDataAsJSON();
            let rowKeyValue = "";//getCellData(grd.getSelectedRow, keyfield);
            editorsValues = grd.getGridEditorsData();
            data = {
                tableName: grd.getID(),
                action: 'EditorOnChange',
                rowKeyValue: rowKeyValue,
                rowIndex: selectedRowIndex,
                rowData: rowData,
                editorsData: editorsValues,
                editorName: comboGetLastSegment((editor.id.replace("_vi", ""))),
                editorValue: editorValue,

            };
            submitData("/tbgrid/dispatch.htm", data, null);

        } else
            console.log("OnGridEditor change event couldn't find grid:" + grdName);


    } else//nornal form editor.
    {
        data = {
            editorName: editor.id.replace("_vi", ""),
            action: 'OnChange',
            value: editorValue,
             args:args,
        };
        submitData("/tbeditor/dispatch.htm", data, null);

    }



}

function clickMethodServer(editor,args = null) {


    const data = {
        editorName: editor.id,
        action: 'OnClick',
        value: editor.value,
        args:args,
    };

    submitData("/tbeditor/dispatch.htm", data, null);
}

