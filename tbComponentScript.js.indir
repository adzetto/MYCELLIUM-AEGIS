let currentIndex = -1;
let iShowingSearchBox = false;
let debounceTimeout;


async function comboGetData(comboName, searchTerm) {
    const resultsList = document.getElementById(comboName + '_searchResults');
    resultsList.innerHTML = '<li class="loading-item">Yükleniyor...</li>';
    comboShowSearchBox(comboName);

    try {
        //send data
        if (searchTerm.length > 2)
        {
            const sendData = {
                editorName: comboName,
                action: 'comboSearch',
                searchText: searchTerm,
            };

            resultsList.innerHTML = '<li class="loading-item">Yükleniyor...</li>';
            await submitData("/tbeditor/dispatch.htm", sendData, (data) => {
                resultsList.innerHTML = '';
                if (!data.comboSearchResult)
                    return;
                if (data.comboSearchResult.length === 0) {
                    resultsList.innerHTML = '<li class="no-results-item">Sonuç bulunamadı</li>';
                    return;
                }
                if (Array.isArray(data.comboSearchResult)) {

                    data.comboSearchResult.forEach(item => {
                        const li = document.createElement('li');
                        li.id = `${comboName}_${item.id}`;
                        li.textContent = item.text;
                        li.setAttribute('onclick', 'comboSelectOption(this)');

                        resultsList.appendChild(li);
                    });
                }
            });

        } else
        {
            //resultsList.innerHTML = '<li class="no-results-item">En az 3 karakter giriniz.</li>';
            resultsList.innerHTML = '<li  style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">  En az 3 karakter giriniz.</li>';

            if (searchTerm.length === 0)
                comboHideSearchBox(comboName);
        }




    } catch (error) {
        console.error('Veri alınırken hata oluştu:', error);
        resultsList.innerHTML = '<li class="no-results-item">Bir hata oluştu</li>';
    }
}


function comboOnchange(inp)
{
    vi = document.getElementById(inp.id + "_vi");

    findID = comboFindText(inp.id);
    if (findID !== "")
    {
        inp.value = comboGetLastSegment(findID);
    } else
    {
        if (vi.alt === "fixed")
        {
            inp.value = "";
            vi.value = "";
        }
    }

    //console.log("after Find=" + inp.id + "/" + inp.value + "/" + vi.value);
    // comboHideSearchBox(inp.id);
}




function comboHideSearchBox(comboName) {
    const dropdown = document.getElementById(comboName + "_searchResults");

    dropdown.style.display = "none";

    if (dropdown._outsideClickListener) {
        document.removeEventListener('click', dropdown._outsideClickListener);
        dropdown._outsideClickListener = null;
    }

    if (dropdown._repositionHandler) {
        document.removeEventListener('scroll', dropdown._repositionHandler, true);
        dropdown._repositionHandler = null;
    }
    dropdown.style.position = 'absolute';
    iShowingSearchBox = false;
}

function comboFilterOptions(comboName) {


    if (!iShowingSearchBox)
        comboShowSearchBox(comboName);

    const searchInput = document.getElementById(comboName + "_vi");
    const searchInputText = searchInput.value.toLowerCase();
    const searchServerSide = searchInput.getAttribute("searchServerSide");
    if (searchServerSide && searchServerSide === "true") {
        clearTimeout(debounceTimeout);
        debounceTimeout = setTimeout(() => {
            comboGetData(comboName, searchInputText);
        }, 350);
    } else
    {
        const options = document.querySelectorAll("#" + comboName + "_searchResults li");

        options.forEach(option => {
            const text = option.textContent.toLowerCase();
            option.style.display = text.includes(searchInputText) ? "" : "none";
        });
    }

    currentIndex = -1;
}

function comboFilterClear(comboName) {

    const searchInput = document.getElementById(comboName + "_vi").value.toLowerCase();
    const options = document.querySelectorAll("#" + comboName + "_searchResults li");

    options.forEach(option => {
        option.style.display = "";
    });

    currentIndex = -1;
}

function comboFindText(comboName) {
    const searchInput = document.getElementById(comboName + "_vi").value.toLowerCase();
    const options = document.querySelectorAll("#" + comboName + "_searchResults li");
    let found = "";
    options.forEach(option => {
        const text = option.textContent.toLowerCase();
        //option.style.display="";
        if (text === searchInput)
        {
            found = option.id;
        }
    });
    return found;
}

function comboGetLastSegment(text) {
    if (!text || !text.includes('_'))
        return text;
    const parts = text.trim().split('_');
    return parts[parts.length - 1];
}

function comboGetPrefix(text) {
    if (!text || !text.includes('_'))
        return text;
    const lastUnderscoreIndex = text.trim().lastIndexOf('_');
    return text.slice(0, lastUnderscoreIndex);
}

function comboGetSegmentByIndex(text, index) {
    if (!text || typeof index !== "number" || index < 0)
        return "";

    const parts = text.trim().split("_");

    return parts[index] !== undefined ? parts[index] : "";
}

function comboGetSegmentsFromIndex(text, index) {
    if (!text || typeof index !== "number" || index < 0) {
        return "";
    }

    const parts = text.trim().split("_");


    if (index < parts.length) {
        return parts.slice(index).join("_");
    }

    return "";
}



function comboSelectOption(value) {
    //const vals = value.id.split('_');
    const inputName = comboGetPrefix(value.id);
    const inputValue = comboGetLastSegment(value.id);

    const searchBox = document.getElementById(inputName);
    const searchBoxVi = document.getElementById(inputName + "_vi");
    searchBox.value = inputValue;
    searchBoxVi.value = value.innerHTML;

    searchBoxVi.onchange();


    comboHideSearchBox(inputName);

    //console.log("comboSelectOption=");
}

function comboNavigateOptions(event, comboName) {
    const options = Array.from(document.querySelectorAll("#" + comboName + "_searchResults li"));
    const visibleOptions = options.filter(option => option.style.display !== "none");

    if (visibleOptions.length === 0)
        return;

    if (event.key === "ArrowDown") {
        event.preventDefault();
        currentIndex = (currentIndex + 1) % visibleOptions.length;
        comboUpdateFocus(visibleOptions);
    } else if (event.key === "ArrowUp") {
        event.preventDefault();
        currentIndex = (currentIndex - 1 + visibleOptions.length) % visibleOptions.length;
        comboUpdateFocus(visibleOptions);
    } else if (event.key === "Enter") {
        event.preventDefault();
        if (currentIndex >= 0 && currentIndex < visibleOptions.length) {
            comboSelectOption(visibleOptions[currentIndex]);

        }
    } else if (event.key === "Escape") {
        comboHideSearchBox(comboName);
    }
}

function comboUpdateFocus(visibleOptions) {
    visibleOptions.forEach((option, index) => {
        option.style.backgroundColor = index === currentIndex ? "#f0f0f0" : "#fff";
    });

    if (currentIndex >= 0 && currentIndex < visibleOptions.length) {
        visibleOptions[currentIndex].scrollIntoView({block: "nearest"});
    }
}




function comboShowSearchBox(comboName) {
//    console.log(comboName);
//    const dropdown = document.getElementById(comboName + "_searchResults");
//    dropdown.style.display = "block";
//    iShowingSearchBox = true;
    const dropdown = document.getElementById(comboName + "_searchResults");
    const input_vi = document.getElementById(comboName + '_vi');
    const toggleButton = document.getElementById(comboName + '_toggleButton');


    if (dropdown.parentElement !== document.body) {
        document.body.appendChild(dropdown);
        dropdown.style.zIndex = '9999';
    }


    dropdown.style.position = 'fixed';


    dropdown._repositionHandler = () => {
        const inputRect = input_vi.getBoundingClientRect();

        dropdown.style.top = inputRect.bottom + 'px'; // Input'un altı
        dropdown.style.left = inputRect.left + 'px';   // Input'un solu
        dropdown.style.width = inputRect.width + 'px'; // Input ile aynı genişlik
    };


    dropdown.style.display = 'block';
    dropdown._repositionHandler();
    iShowingSearchBox = true;


    input_vi.focus();


    setTimeout(() => {
        dropdown._outsideClickListener = (event) => {
            if (!dropdown.contains(event.target) &&
                    event.target !== input_vi &&
                    !toggleButton.contains(event.target))
            {
                comboHideSearchBox(comboName);
            }
        };
        document.addEventListener('click', dropdown._outsideClickListener);
    }, 0);


    // hem window scroll'unu hem de popup içindeki div scroll'unu yakalar.
    document.addEventListener('scroll', dropdown._repositionHandler, true);
}


function comboToggleDropdown(comboName) {
    comboFilterClear(comboName);

    const dropdown = document.getElementById(comboName + "_searchResults");


    if (dropdown._outsideClickListener) {
        comboHideSearchBox(comboName);
    } else {
        comboShowSearchBox(comboName);
    }
}

function downloadURL(url, fileName = null) {
    const link = document.createElement("a");
    link.href = url;
    link.download = fileName;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}

function fileUploadOnchange(uploadItem)
{
    const file = uploadItem.files[0];

    if (file) {
        const blobUrl = URL.createObjectURL(file);
        downloadBtn = document.getElementById("donwloadBtn_" + uploadItem.name);
        if (downloadBtn)
            downloadBtn.onclick = function () {
                downloadURL(blobUrl, file.name);
            };
        document.getElementById("fileText_" + uploadItem.id).value = file.name;
    }
}
//---------------------------GRID------------------------------

function initializeTableGrid(gridContainer, keyfield, filterText) {
    const tableBody = gridContainer.querySelector("tbody");
    const searchInput = gridContainer.querySelector(".searchInput");
    const clearBtn = gridContainer.querySelector(".clear-button");
    const exportXlsxBtn = gridContainer.querySelector(".export-xlsx");
    const searchContainer = gridContainer.querySelector(".search-container");
    const contextMenu = gridContainer.querySelector(".context-menu");
    const rowCountSpan = gridContainer.querySelector(".rowCount");
    const headers = gridContainer.querySelectorAll("thead th");
    const contextMenuItems = contextMenu ? contextMenu.querySelectorAll("li[data-action]") : [];
    const selectAllCheckbox = document.getElementById('selectAllCheckbox');
    const tableWrapper = gridContainer.querySelector('.table-wrapper');
    const loadingIndicator = gridContainer.querySelector('.loading-indicator');
    const isEditableRow = gridContainer.getAttribute("rowediting") === "true";
    const isEditable = gridContainer.getAttribute("editable") === "true";


    let selectedRow = null;
    const sortDirections = {};
    let isLoading = false;
    let loadedRows = 50;




    let inlineEditingRow = null; // Şu an editlenen satır
    let originalRowHTML = null;  // Satırın orijinal hali (Cancel için)
    let movedEditors = [];       // Popup'tan ödünç aldığımız editörlerin listesi
    let inlineOriginalData = null;



    function getVisibleRows() {
        return Array.from(tableBody.querySelectorAll("tr:not(#empty_row):not([style*='display: none'])"));
    }

    function getNumericValueFromCell(cell) {
        if (!cell)
            return 0;


        // Örn: <td data-columnvalue="1500.50">1.500,50</td>
        const rawValue = cell.getAttribute('data-columnvalue');
        let text = "";

        if (rawValue) {
            // "1500.50" (noktalı) formatını direkt kullan
            text = rawValue;
        } else {
            // "1.500,50" (virgüllü) formatını al
            text = cell.textContent.trim();
            // 1. Binlik ayıracı olan noktaları kaldır (sadece textContent'ten geliyorsa)
            text = text.replace(/\./g, '');
            // 2. Ondalık ayıracı olan virgülü noktaya çevir (sadece textContent'ten geliyorsa)
            text = text.replace(',', '.');
            // 3. Sayısal olmayan diğer karakterleri (para birimi vb.) temizle
            text = text.replace(/[^\d.-]/g, '');
        }



        const value = parseFloat(text);
        return isNaN(value) ? 0 : value;
    }



    function calculateSum(columnName) {
        const rows = getVisibleRows();
        let total = 0;
        rows.forEach(row => {
            const cell = row.querySelector(`td[data-columnname^="${columnName}_"]`);
            if (cell) {
                total += getNumericValueFromCell(cell);
            }
        });
        return total;
    }

    function calculateAverage(columnName) {
        const rows = getVisibleRows();
        if (rows.length === 0)
            return 0;

        const total = calculateSum(columnName); // Toplamı yeniden kullan
        return total / rows.length;
    }


    function calculateCount() {
        return getVisibleRows().length;
    }



    function updateFooterSummaries() {
        const tableFooter = gridContainer.querySelector("table tfoot");
        if (!tableFooter)
            return; // Footer yoksa işlem yapma

        const footerRow = tableFooter.querySelector("tr");
        if (!footerRow)
            return;

        // data-summary-type özniteliğine sahip TÜM footer hücrelerini seç
        footerRow.querySelectorAll("td[data-summary-type]").forEach((cell) => {

            const summaryType = cell.dataset.summaryType;

            const columnName = cell.dataset.columnName;


            if (summaryType && columnName) {
                let rawValue = 0;
                let formattedResult = "";

                switch (summaryType.toUpperCase()) {
                    case "SUM":
                        rawValue = calculateSum(columnName);
                        formattedResult = rawValue.toLocaleString('tr-TR', {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });
                        break;

                    case "AVG":
                        rawValue = calculateAverage(columnName);
                        formattedResult = rawValue.toLocaleString('tr-TR', {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });
                        break;

                    case "COUNT":
                        rawValue = calculateCount(); // Sütun adı gerekmez
                        formattedResult = rawValue.toLocaleString('tr-TR');
                        break;

                    default:
                        formattedResult = "";
                }

                cell.textContent = formattedResult;

            } else if (summaryType && summaryType.toUpperCase() === "COUNT") {

                let rawValue = calculateCount();
                cell.textContent = rawValue.toLocaleString('tr-TR');
            }

        });
    }


    function exportExcel() {
        let tableId = gridContainer.id;
        let gridName = comboGetSegmentByIndex(tableId, 1);
        const table = document.getElementById(tableId);

        // Hariç tutulacak sütun id veya class listesi
        const excludedColumns = [
            "column_command",
            "column_check",
            "actions-column"
        ];

        // Yeni tablo oluştur (yalnızca istenen kolonlar)
        const filteredTable = document.createElement("table");

        // <thead> kopyala
        const thead = table.querySelector("thead");
        if (thead) {
            const newThead = thead.cloneNode(true);
            cleanExcludedColumns(newThead, excludedColumns);
            filteredTable.appendChild(newThead);
        }

        // <tbody> kopyala
        const tbody = document.createElement("tbody");
        for (let row of table.querySelectorAll("tbody tr")) {
            const newRow = row.cloneNode(true);
            cleanExcludedColumns(newRow, excludedColumns);
            tbody.appendChild(newRow);
        }
        filteredTable.appendChild(tbody);


        const wb = XLSX.utils.table_to_book(filteredTable, {sheet: "Sayfa1", raw: true});
        XLSX.writeFile(wb, gridName + "_Excel.xlsx");
    }


    function cleanExcludedColumns(container, excludedColumns) {
        container.querySelectorAll("th, td").forEach(cell => {
            const id = cell.id || "";
            const cls = cell.className || "";
            if (excludedColumns.some(ex => id.includes(ex) || cls.includes(ex))) {
                cell.remove();
            }
        });
    }


    // Endless scrolling
    setEndlesPageListening();
    function setEndlesPageListening() {
        if (tableWrapper.getAttribute("showpage"))
        {
            tableWrapper.addEventListener('scroll', () => {
                const {
                    scrollTop,
                    scrollHeight,
                    clientHeight
                } = tableWrapper;

                if (scrollTop + clientHeight >= scrollHeight - 100) { // 100px buffer

                    loadMoreRecords();


                }
            });
        }
    }

    function loadMoreRecords(args = null) {
        if (isLoading)
            return;
        isLoading = true;
        loadingIndicator.classList.add('active');

        let lim = 20;

        const pageSizeAttr = tableWrapper.getAttribute("pagesize");
        if (pageSizeAttr)
            lim = parseInt(pageSizeAttr, 10);
        //console.log(lim);
        loadMoreRows(gridContainer.id, "/tbgrid/dispatch.htm", {offset: loadedRows, limit: lim}, args);

    }


    function loadMoreRows(tableId, endpoint, requestData, args = null) {
        const table = document.getElementById(tableId);
        if (!table) {
            console.error("Tablo bulunamadı:", tableId);
            return;
        }
        const tbody = table.querySelector("tbody");
        const emptyRow = document.getElementById("empty_row");

        if (!tbody || !emptyRow) {
            console.error("Tbody veya empty_row bulunamadı.");
            return;
        }

        // Server’dan verileri çek

        const data = {
            tableName: gridContainer.id,
            action: "GetRows",
            rowKeyValue: "",
            rowIndex: "",
            requestData: requestData,
            args: args,

        };

        submitData(endpoint, data, function (response) {

            if (response.resultRowsHtml !== null) {
                const emptyRow = tableBody.rows[tbody.rows.length - 1];
                if (loadedRows === 0)//yeni refresh islemi yapıyor dolayısı ile eski kayıtları sil.
                {
                    Array.from(tbody.rows).forEach(row => {
                        if (row.id !== "empty_row") {
                            row.remove();
                        }
                    });
                }
                if (response.resultRowsHtml !== "") {
                    emptyRow.insertAdjacentHTML("beforebegin", response.resultRowsHtml);
                    tableBody.querySelectorAll('.action-button.edit').forEach(button => {
                        button.onclick = function () {
                            editRowClick(this.closest('tr'));
                        };
                    });
                    tableBody.querySelectorAll('.action-button.delete').forEach(button => {
                        button.onclick = function () {
                            deleteRowClick(this.closest('tr'));
                        };
                    });
                }
            }



            loadingIndicator.classList.remove('active');
            loadedRows = loadedRows + requestData.limit;
            if (response.result === "true")
                isLoading = false;
            updateFooterSummaries();
            updateDeletedRowCount();
            applyEllipsisTooltips();
            if (isEditable)
                takeAllPagesSnapshots();

            if (filterText && filterText !== "")
            {
                filterTable(filterText);
            }

            return;


        });
    }


    async function hideContextMenu() {
        return new Promise((resolve) => {
            if (contextMenu && contextMenu.style.display === "block") {
                contextMenu.style.display = "none";

                setTimeout(resolve, 0);
            } else {
                resolve();
            }
        });
    }

    function clearAllSelections() {
        if (tableBody) {
            tableBody.querySelectorAll("tr.selected").forEach(r => r.classList.remove("selected"));
        }
        selectedRow = null;
    }

    function repositionContextMenuIfNeeded(menu, targetX, targetY) {
        if (!menu)
            return;
        const menuRect = menu.getBoundingClientRect();
        const viewportWidth = document.documentElement.clientWidth;
        const viewportHeight = document.documentElement.clientHeight;
        let relativeX = targetX - window.scrollX;
        let relativeY = targetY - window.scrollY;

        if (relativeX + menuRect.width > viewportWidth)
            relativeX = viewportWidth - menuRect.width - 5;
        if (relativeY + menuRect.height > viewportHeight)
            relativeY = viewportHeight - menuRect.height - 5;
        if (relativeX < 0)
            relativeX = 5;
        if (relativeY < 0)
            relativeY = 5;

        const finalX = relativeX + window.scrollX;
        const finalY = relativeY + window.scrollY;
        const gridRect = gridContainer.getBoundingClientRect();
        const relativeToGridX = finalX - (gridRect.left + window.scrollX);
        const relativeToGridY = finalY - (gridRect.top + window.scrollY);

        menu.style.left = `${relativeToGridX}px`;
        menu.style.top = `${relativeToGridY}px`;
    }

    function updateSortIcons(sortedColumnIndex, direction) {
        headers.forEach((th, index) => {
            const existingIcon = th.querySelector(".sort-icon");
            if (existingIcon)
                th.removeChild(existingIcon);
            if (index === sortedColumnIndex) {
                const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                svg.setAttribute("viewBox", "0 0 24 24");
                svg.setAttribute("class", "sort-icon");
                svg.innerHTML = direction === "asc" ? '<path d="M7 14l5-5 5 5z"/>' : '<path d="M7 10l5 5 5-5z"/>';
                th.appendChild(svg);
            }
        });
    }

    function searchTable() {
        if (!searchInput || !tableBody)
            return;
        const filter = searchInput.value.toUpperCase().trim();
        const rows = tableBody.querySelectorAll("tr");
        if (clearBtn)
            clearBtn.style.display = filter ? "block" : "none";
        rows.forEach(row => {
            const text = Array.from(row.cells).map(td => td.textContent).join(" ");
            if (!row.id.includes("empty_row") && row.getAttribute('status') !== "deleted")
                row.style.display = text.toUpperCase().includes(filter) ? "" : "none";
        });
        updateFooterSummaries();

    }


    function filterTable(searchText = null) {
        if (!tableBody)
            return;

        const rows = tableBody.querySelectorAll("tr");

        const expressionFn = buildSqlExpression(searchText);

        rows.forEach(row => {
            if (!row.id.includes("empty_row") && row.getAttribute('status') !== "deleted")
            {
                if (!searchText || searchText.trim() === "")
                    row.style.display = "";
                else
                    row.style.display = expressionFn(row) ? "" : "none";
            }
        });
        filterText = searchText;

        updateFooterSummaries();
    }

    function buildSqlExpression(searchText) {
        if (searchText && searchText !== "")
        {
            const tokens = tokenize(searchText);
            const ast = parseExpression(tokens);
            return row => evaluateAst(ast, row);
        }
        return null;
    }

    function tokenize(input) {
        const regex = /\s*(AND|OR|\(|\)|<>|!=|=|LIKE|[a-zA-Z_][a-zA-Z0-9_]*|'[^']*')\s*/gi;

        let tokens = [];
        let match;

        while ((match = regex.exec(input)) !== null) {
            tokens.push(match[1]);
        }

        return tokens;
    }

    function parseExpression(tokens) {
        let pos = 0;

        function parsePrimary() {
            if (tokens[pos] === "(") {
                pos++;
                const expr = parseOr();
                if (tokens[pos] !== ")")
                    throw new Error("Eksik )");
                pos++;
                return expr;
            }
            return parseCondition();
        }

        function parseCondition() {
            const column = tokens[pos++];
            const operator = tokens[pos++].toUpperCase();

            const valueToken = tokens[pos++];
            const value = valueToken.substring(1, valueToken.length - 1);

            return {type: "condition", column, operator, value};
        }

        function parseAnd() {
            let node = parsePrimary();
            while (tokens[pos] && tokens[pos].toUpperCase() === "AND") {
                pos++;
                node = {type: "AND", left: node, right: parsePrimary()};
            }
            return node;
        }

        function parseOr() {
            let node = parseAnd();
            while (tokens[pos] && tokens[pos].toUpperCase() === "OR") {
                pos++;
                node = {type: "OR", left: node, right: parseAnd()};
            }
            return node;
        }

        return parseOr();
    }



    function evaluateAst(node, row) {
        switch (node.type) {
            case "condition":
                return evaluateCondition(node, row);
            case "AND":
                return evaluateAst(node.left, row) && evaluateAst(node.right, row);
            case "OR":
                return evaluateAst(node.left, row) || evaluateAst(node.right, row);
        }
    }


    function evaluateCondition(cond, row) {
        const cell = row.querySelector(`[data-columnname^="${cond.column}"]`);
        if (!cell)
            return false;

        const text = (cell.textContent || "").toUpperCase();
        const value = cond.value.toUpperCase();

        // = eşitlik
        if (cond.operator === "=") {
            return text === value;
        }

        // <> ve != (eşit değildir)
        if (cond.operator === "<>" || cond.operator === "!=") {
            return text !== value;
        }

        // LIKE işlemleri
        if (cond.operator === "LIKE") {
            let pattern = value
                    .replace(/[%\*]/g, ".*")
                    .replace(/\?/g, ".");

            const regex = new RegExp("^" + pattern + "$", "i");
            return regex.test(text);
        }

        return false;
    }


    function clearSearch() {
        if (!searchInput)
            return;
        searchInput.value = "";
        searchTable();
        searchInput.focus();
    }

    function toggleSearchVisibility() {
        if (!searchContainer)
            return;
        const isVisible = searchContainer.style.display === "block";
        searchContainer.style.display = isVisible ? "none" : "block";
        if (!isVisible && searchInput)
            searchInput.focus();
        hideContextMenu();
    }

    function sortTable(columnIndex) {
        if (!tableBody)
            return;

        const visibleRows = Array.from(
                tableBody.querySelectorAll("tr:not([style*='display: none']):not(#empty_row)")
                );

        // "empty_row" olan satırları ayrı tut
        const emptyRows = Array.from(
                tableBody.querySelectorAll("tr#empty_row")
                );

        if (visibleRows.length === 0) {
            updateSortIcons(columnIndex, sortDirections[columnIndex] || 'asc');
            return;
        }


        const currentDir = sortDirections[columnIndex];
        const dir = currentDir === "asc" ? "desc" : "asc";
        sortDirections[columnIndex] = dir;

        visibleRows.sort((a, b) => {
            const cellA = a.cells[columnIndex];
            const cellB = b.cells[columnIndex];

            const valA = cellA ? cellA.textContent.trim() : '';
            const valB = cellB ? cellB.textContent.trim() : '';

            const numA = parseFloat(valA);
            const numB = parseFloat(valB);

            // Tarih formatı kontrolleri
            const isDateDMY = /^\d{2}\.\d{2}\.\d{4}$/.test(valA) && /^\d{2}\.\d{2}\.\d{4}$/.test(valB);
            const isDateYMD = /^\d{4}-\d{2}-\d{2}$/.test(valA) && /^\d{4}-\d{2}-\d{2}$/.test(valB);

            if (isDateDMY || isDateYMD) {
                const parseDate = (val) => {
                    if (/^\d{2}\.\d{2}\.\d{4}$/.test(val)) {
                        const [day, month, year] = val.split('.');
                        return new Date(`${year}-${month}-${day}`);
                    } else if (/^\d{4}-\d{2}-\d{2}$/.test(val)) {
                        return new Date(val);
                    }
                    return null;
                };

                const dateA = parseDate(valA);
                const dateB = parseDate(valB);

                if (dateA && dateB) {
                    return dir === 'asc' ? dateA - dateB : dateB - dateA;
                }
            }

            if (!isNaN(numA) && !isNaN(numB) && valA !== '' && valB !== '') {
                return dir === 'asc' ? numA - numB : numB - numA;
            }

            return dir === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
        });

        visibleRows.forEach(row => tableBody.appendChild(row));


        emptyRows.forEach(row => tableBody.appendChild(row));


        updateSortIcons(columnIndex, dir);
        updateFooterSummaries();
    }

    function showContextMenu(event, targetRow) {
        clearAllSelections();

        if (targetRow && targetRow.id !== "empty_row") {
            targetRow.classList.add("selected");
            selectedRow = targetRow;
        } else {
            selectedRow = null;
        }


        contextMenuItems.forEach(item => {
            const action = item.dataset.action;

            if (['edit', 'delete', 'details'].includes(action)) {
                if (selectedRow) {
                    item.classList.remove('disabled');
                } else {
                    item.classList.add('disabled');
                }
            } else {
                item.classList.remove('disabled');
            }
        });


        const gridRect = gridContainer.getBoundingClientRect();
        const relativeX = event.clientX - gridRect.left;
        const relativeY = event.clientY - gridRect.top;

        contextMenu.style.left = `${relativeX}px`;
        contextMenu.style.top = `${relativeY}px`;
        contextMenu.style.display = "block";
        repositionContextMenuIfNeeded(contextMenu, event.pageX, event.pageY);
    }

    function getCellData(row, columnName) {
        if (!row)
            return 'N/A';
        if (!columnName && columnName === '')
            return 'N/A';
        for (let i = 0; i < row.cells.length; i++) {
            if (comboGetPrefix(row.cells[i].dataset.columnname) === columnName) {
                return row.cells[i].textContent;
            }
        }
        return 'N/A';
    }

    function getRowData(row) {
        const cellValues = [];
        if (!row)
            return 'N/A';

        rowStatus = row.getAttribute('status');
        cellValues.push('status' + ':' + rowStatus);
        for (let i = 0; i < row.cells.length; i++) {
            colName = row.cells[i].dataset.columnname;

            if (colName && colName !== "") {
                colName = colName.split('_')[0];
                colVal = row.cells[i].dataset.columnvalue;//combobox,currency
                if (colVal && colVal !== "")
                    cellValues.push(colName + ':' + colVal);
                else
                    cellValues.push(colName + ':' + row.cells[i].innerText);
            }
        }
        return cellValues;
    }

    function getGridEditorsData() {
        let tableId = gridContainer.id;
        const inputValues = [];
        let container;

        // Inline edit yapılıyorsa satıra, yoksa panele bak
        if (inlineEditingRow) {
            container = inlineEditingRow;
        } else {
            let panelId = "editPopPanel_" + tableId;
            container = document.getElementById(panelId);
        }

        const inputs = container.querySelectorAll('input:not([type="button"]):not([type="submit"]):not([type="reset"]), textarea');
        inputs.forEach((input) => {
            const editorName = comboGetSegmentsFromIndex(input.id, 2);
            inputValues.push(editorName + ':' + input.value);
        });
        return inputValues;
    }

    function removeSelectedRow()
    {
        if (selectedRow.getAttribute("status") !== "inserted")
        {

            selectedRow.setAttribute("status", "deleted");
            selectedRow.style.display = "none";
            selectedRow.classList.remove("selected");

            updateDeletedRowCount();
        } else
            selectedRow.remove();
        selectedRow = null;
        updateFooterSummaries();
    }

    function removeRow(updated)
    {
        if (JSON.parse(updated.result) === true)
        {
            removeSelectedRow();

        }

    }

    function saveRow(updated) {
        tableId = gridContainer.id;
        panelId = "editPopPanel_" + tableId;
        const panel = document.getElementById(panelId);
        const inputs = panel.querySelectorAll('input:not([type="button"]):not([type="submit"]):not([type="reset"]), textarea');

        if (JSON.parse(updated.result) === true) {
            const EMPTY_ROW_ID = 'empty_row';
            tableId = tableId.replace("Div", "");

            const table = document.getElementById(tableId);
            const tbody = table.querySelector('tbody');
            const emptyRow = tbody.rows[tbody.rows.length - 1];

            if (!panel || !table || !tbody) {
                console.error('Hata: Belirtilen panel veya tablo bulunamadı.');
                return;
            }


            const columnHeaderMap = new Map();
            const headerCells = table.querySelectorAll('thead th');

            headerCells.forEach((th, index) => {
                if (th.id) {
                    columnHeaderMap.set(th.id, {
                        index: index,
                        // TH elementinin hesaplanmış text-align stilini al
                        textAlign: window.getComputedStyle(th).textAlign
                    });
                }
            });

            const newRow = document.createElement('tr');
            newRow.setAttribute('status', 'inserted');

            if (emptyRow && emptyRow.parentNode.nodeName === "TBODY") {
                tbody.insertBefore(newRow, emptyRow);
            } else {
                tbody.appendChild(newRow);
            }

            // Yeni satıra benzersiz bir ID ata
            let currentRowCount = tbody.querySelectorAll('tr:not(#' + EMPTY_ROW_ID + ')').length;
            newRow.id = `row_${currentRowCount - 1}`;


            for (let i = 0; i < headerCells.length; i++) {
                const cell = newRow.insertCell();
                cell.style.backgroundColor = '#96DD9F';


                const th = headerCells[i];
                if (th.id) {
                    const columnData = columnHeaderMap.get(th.id);
                    if (columnData && columnData.textAlign) {
                        cell.style.textAlign = columnData.textAlign;
                    }
                }
            }


            inputs.forEach((input, index) => {
                const idParts = input.id.split('_');
                const editorName = idParts[idParts.length - 1];

                const columnHeaderId = `column_${editorName}`;

                // Burada sadece index değil, tüm columnData nesnesini alıyoruz.
                const columnData = columnHeaderMap.get(columnHeaderId);
                const columnIndex = columnData ? columnData.index : undefined;

                if (columnIndex !== undefined) {
                    const targetCell = newRow.cells[columnIndex];
                    // ... (Geri kalan kodunuz aynı kalır)
                    if (targetCell) {
                        if (input.type === "date")
                            targetCell.textContent = dateToString(input.value);
                        else if (input.type === "datetime-local")
                            targetCell.textContent = dateTimeToString(input.value);
                        else if (input.type === "hidden")/*combobox*/ {
                            const visibleInput = document.getElementById(input.id + "_vi");
                            if (visibleInput) {
                                targetCell.textContent = visibleInput.value ? visibleInput.value : "";
                                targetCell.setAttribute('data-columnvalue', input.value ? input.value : "")
                            }
                        } else
                            targetCell.textContent = input.value;

                        targetCell.setAttribute('data-columnname', `${editorName}_${columnIndex}`);
                    }
                }
                input.value = '';
            });

            const commandColumnData = columnHeaderMap.get(tableId + "_column_command");
            const commandColumnIndex = commandColumnData ? commandColumnData.index : undefined;

            if (commandColumnIndex !== undefined) {
                const targetCell = newRow.cells[commandColumnIndex];
                targetCell.classList.add("actions-column");
                targetCell.innerHTML = '<div class="action-buttons">  <button type="button" title="Kaydı Düzenle" class="action-button edit"></button>  <button type="button" title="Kaydı Sil" class="action-button delete"></button></div>';


                targetCell.querySelectorAll('.action-button.edit').forEach(button => {
                    button.onclick = function () {
                        editRowClick(this.closest('tr'));
                    };
                });

                targetCell.querySelectorAll('.action-button.delete').forEach(button => {
                    button.onclick = function () {
                        deleteRowClick(this.closest('tr'));
                    };
                });
            }


            inputs.forEach((input) => {
                input.value = '';
                input.classList.remove('input-error');
            });

            updateFooterSummaries();
            popElementCloseButton = document.getElementById("editPop_" + tableId.split('_')[1]);
            if (popElementCloseButton) {
                hidePopup(popElementCloseButton);
            }
        }
    }

    function updateRow(updated) {

        if (inlineEditingRow) {
            if (JSON.parse(updated.result) === true) {

                // 1. ÖNCE değerleri hücrelere yaz ve DEĞİŞİKLİK KONTROLÜ YAP
                const panelId = "editPopPanel_" + gridContainer.id;

                movedEditors.forEach(item => {
                    const containerEl = item.element;
                    let el = containerEl;

                    // Eğer kapsayıcı DIV ise asıl inputu bul
                    if (containerEl.tagName === 'DIV') {
                        el = containerEl.querySelector('input:not([id$="_vi"])') || containerEl.querySelector('select') || containerEl.querySelector('textarea') || containerEl.querySelector('input');
                    }

                    if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'SELECT')) {

                        const idParts = el.id.split('_');
                        const editorName = idParts[idParts.length - 1];
                        const targetCell = inlineEditingRow.querySelector(`td[data-columnname^="${editorName}_"]`);

                        if (targetCell) {
                            // --- DEĞİŞİKLİK KONTROLÜ BAŞLANGICI ---

                            // 1. Eski Değeri Bul (inlineOriginalData içinden)
                            let oldValue = "";
                            if (inlineOriginalData) {
                                // Data formatı: "columnName:value"
                                const foundItem = inlineOriginalData.find(d => d.startsWith(editorName + ":"));
                                if (foundItem) {
                                    // "name:Ahmet" -> "Ahmet"
                                    oldValue = foundItem.substring(editorName.length + 1);
                                }
                            }

                            // 2. Yeni Değeri Hazırla (Karşılaştırma için formatla)
                            let newValueForComparison = el.value;

                            // Tarih alanları için format dönüşümü yap ki doğru karşılaştırılsın
                            if (el.type === "date") {
                                newValueForComparison = dateToString(el.value);
                            } else if (el.type === "datetime-local") {
                                newValueForComparison = dateTimeToString(el.value);
                            }

                            // 3. Karşılaştır ve Renklendir                            
                            if (String(newValueForComparison).trim() !== String(oldValue).trim()) {
                                targetCell.style.backgroundColor = '#96DD9F';
                                targetCell.setAttribute('status', 'updated');

                                // Satır statüsünü de güncelle
                                if (inlineEditingRow.getAttribute('status') !== "inserted") {
                                    inlineEditingRow.setAttribute('status', 'updated');
                                }
                            } else {
//                                targetCell.style.backgroundColor = '';
//                                targetCell.removeAttribute('status');
                            }



                            // --- HÜCREYİ GÜNCELLEME  ---
                            if (el.getAttribute("editortype") === "CURRENCY" || el.getAttribute("editortype") === "COMBOBOX") {
                                let vInput = document.getElementById(el.id + "_vi");
                                if (vInput && el.type === 'hidden') {
                                    targetCell.textContent = vInput.value;
                                    targetCell.setAttribute('data-columnvalue', el.value);
                                } else if (el.getAttribute("editortype") === "CURRENCY") {
                                    if (vInput)
                                        targetCell.textContent = vInput.value;
                                    else
                                        targetCell.textContent = el.value;
                                }
                            } else if (el.type === "date") {
                                targetCell.textContent = dateToString(el.value);
                            } else if (el.type === "datetime-local") {
                                targetCell.textContent = dateTimeToString(el.value);
                            } else if (el.type !== "hidden") {
                                targetCell.textContent = el.value;
                            }
                        }


                        el.value = '';
                        const vInput = document.getElementById(el.id + "_vi");
                        if (vInput)
                            vInput.value = '';
                    }
                });

                // 2. Editörleri yerlerine geri taşı
                restoreInlineEditors();

                // 3. Action kolonunu düzelt
                const actionCell = inlineEditingRow.querySelector(".actions-column") || inlineEditingRow.querySelector("td[id*='column_command']");
                if (actionCell) {
                    actionCell.innerHTML = `
                        <div class="action-buttons">
                             <button type="button" title="Kaydı Düzenle" class="action-button edit"></button>
                             <button type="button" title="Kaydı Sil" class="action-button delete"></button>
                        </div>`;
                    actionCell.querySelectorAll('.action-button.edit').forEach(btn => {
                        btn.onclick = function () {
                            editRowClick(this.closest('tr'));
                        };
                    });
                    actionCell.querySelectorAll('.action-button.delete').forEach(btn => {
                        btn.onclick = function () {
                            deleteRowClick(this.closest('tr'));
                        };
                    });
                }


                inlineEditingRow = null;
                originalRowHTML = null;
                inlineOriginalData = null;

                let popElementCloseButton = document.getElementById("editPop_" + gridContainer.id.split('_')[1]);
                if (popElementCloseButton)
                    hidePopup(popElementCloseButton);

                return;

            } else {

                return;
            }
        }

        // --- STANDART POPUP GÜNCELLEME  ---
        let tableId = gridContainer.id;
        let panelId = "editPopPanel_" + tableId;
        const panel = document.getElementById(panelId);
        const inputs = panel.querySelectorAll('input:not([type="button"]):not([type="submit"]):not([type="reset"]), textarea');
        if (JSON.parse(updated.result) === true) {
            const table = document.getElementById(tableId.replace("Div", ""));
            const columnHeaderMap = new Map();
            table.querySelectorAll('thead th').forEach((th, index) => {
                if (th.id)
                    columnHeaderMap.set(th.id, index);
            });

            inputs.forEach((input) => {
                const idParts = input.id.split('_');
                const editorName = idParts[idParts.length - 1];
                const columnHeaderId = `column_${editorName}`;
                const columnIndex = columnHeaderMap.get(columnHeaderId);
                if (columnIndex !== undefined) {
                    const targetCell = selectedRow.cells[columnIndex];
                    if (selectedRow.getAttribute('status') !== "inserted")
                        selectedRow.setAttribute('status', 'updated');

                    if (targetCell.textContent !== input.value) {
                        if (input.getAttribute("editortype") === "CURRENCY"
                                || input.getAttribute("editortype") === "COMBOBOX") {
                            let valueElement = document.getElementById(input.id + "_vi");
                            if (targetCell.textContent !== valueElement.value) {
                                targetCell.style.backgroundColor = '#96DD9F';
                            }
                        } else
                            targetCell.style.backgroundColor = '#96DD9F';
                        targetCell.setAttribute('status', 'updated');
                    }

                    if (input.type === "date")
                        targetCell.textContent = dateToString(input.value);
                    else if (input.type === "datetime-local")
                        targetCell.textContent = dateTimeToString(input.value);
                    else if (input.type === "hidden") {
                        const visibleInput = document.getElementById(input.id + "_vi");
                        if (visibleInput) {
                            targetCell.textContent = visibleInput.value;
                            targetCell.setAttribute('data-columnvalue', input.value);
                        }
                    } else
                        targetCell.textContent = input.value;
                }
                input.value = '';
            });

            let popElementCloseButton = document.getElementById("editPop_" + tableId.split('_')[1]);
            if (popElementCloseButton)
                hidePopup(popElementCloseButton);
        }
    }

    function saveOrUpdateRow() {
        let containerForValidation;

        // Validasyon için doğru yeri seç
        if (inlineEditingRow) {
            containerForValidation = inlineEditingRow;
        } else {
            containerForValidation = getEditorPanel();
        }

        const inputs = containerForValidation.querySelectorAll('input:not([type="button"]):not([type="submit"]):not([type="reset"]), textarea');
        let isValid = true;

        inputs.forEach(input => {
            if (input.hasAttribute('required') && input.value.trim() === '') {
                input.classList.add('input-error');
                if (isValid)
                    input.focus();
                isValid = false;
            } else {
                input.classList.remove('input-error');
            }
        });

        if (!isValid) {
            alert('Lütfen tüm gerekli alanları doldurun.');
            return;
        }

        rowKeyValue = '';
        rowIndex = '';
        if (isupdateRow) {
            rowKeyValue = getCellData(selectedRow, keyfield);
            rowIndex = selectedRow.id;
        }


        if (inlineEditingRow && inlineOriginalData) {
            rowData = inlineOriginalData;
        } else {
            rowData = getRowData(selectedRow);
        }

        editorsValues = getGridEditorsData();
        Action = isupdateRow ? 'Update' : 'Insert';

        const data = {
            tableName: gridContainer.id,
            action: Action,
            rowKeyValue: rowKeyValue,
            rowIndex: rowIndex,
            rowData: rowData,
            editorsData: editorsValues,
        };

        if (isupdateRow)
            submitData("/tbgrid/dispatch.htm", data, (updated) => updateRow(updated));
        else
            submitData("/tbgrid/dispatch.htm", data, (updated) => saveRow(updated));
    }

    function getEditorPanel()
    {
        panelId = "editPopPanel_" + gridContainer.id;
        panel = document.getElementById(panelId);
        return  panel;



    }

    function getInputs()
    {
        panelId = "editPopPanel_" + gridContainer.id;
        panel = document.getElementById(panelId);
        inputs = panel.querySelectorAll('input:not([type="button"]):not([type="submit"]):not([type="reset"]), textarea');
        return  inputs;

    }

    function clearInputs()
    {
        firstInput = null;
        inputs = getInputs();
        counter = 0;
        inputs.forEach((input) => {
            input.value = '';
            if (counter === 0 && !input.disabled && input.type !== 'hidden' && !input.readOnly)
            {
                firstInput = input;
                counter++;
            }
            input.classList.remove('input-error');
        });
        return firstInput;
    }

    function stringToDateTime(text) {
        let date, time;


        if (text.includes("T")) {
            [date, time] = text.split("T");
        } else if (text.includes(" ")) {
            [date, time] = text.split(" ");
        } else {
            console.warn("Tarih formatı geçersiz:", text);
            return null;
        }

        const [day, month, year] = date.split(".");
        return `${year}-${month}-${day}T${time}`;
    }

    function stringToDate(text) {
        const value = text;
        const [date, time] = value.split("T");
        const [day, month, year] = date.split(".");
        return `${year}-${month}-${day}`;
    }

    function dateTimeToString(isoText) {
        if (!isoText)
            return "";
        const [datePart, timePart] = isoText.split("T");
        const [year, month, day] = datePart.split("-");
        let formattedTime = "";
        if (timePart)
            formattedTime = timePart.slice(0, 5) || "00:00";

        return `${day}.${month}.${year} ${formattedTime}`;
    }

    function dateToString(isoText) {
        if (!isoText)
            return "";
        const [datePart] = isoText.split("T");
        const [year, month, day] = datePart.split("-");

        return `${day}.${month}.${year}`;
    }

    function editRow(selectedRow)
    {

        isupdateRow = true;
        firstInput = clearInputs();
        let baseTableId = gridContainer.id.replace("tbGridDiv_", "");
        const panelId = "editPopPanel_" + gridContainer.id;

        const panel = document.getElementById(panelId);

        if (!panel || !selectedRow) {
            console.error('Hata: Düzenleme paneli veya seçili satır bulunamadı.');
            return;
        }


        const panelInputs = panel.querySelectorAll('input:not([type="button"]):not([type="submit"]):not([type="reset"]), textarea');


        panelInputs.forEach(input => {
            input.value = '';
        });


        selectedRow.querySelectorAll('td').forEach(cell => {
            const dataColumnName = cell.getAttribute('data-columnname');

            if (dataColumnName) {

                const columnNameParts = dataColumnName.split('_');
                const actualColumnName = columnNameParts[0];

                const targetInputId = `tbGridEdit_${baseTableId + "_" + actualColumnName}`;
                const targetInput = document.getElementById(targetInputId);
                //combobox ve radio button
                const columnId = cell.getAttribute('data-columnvalue');
                if (targetInput) {
                    if (targetInput.type === "date") {
                        targetInput.value = stringToDate(cell.textContent);
                    } else if (targetInput.type === "datetime-local") {
                        targetInput.value = stringToDateTime(cell.textContent);
                    } else if (columnId !== null)/*checkbox or raido*/ {
                        targetInput.value = columnId;
                        const visibleInput = document.getElementById(targetInputId + "_vi");
                        if (visibleInput) {
                            visibleInput.value = cell.textContent;
                        }

                    } else {
                        targetInput.value = cell.textContent;
                    }
                } else {

                    // console.warn(`Uyarı: '${actualColumnName}' için panelde karşılık gelen bir input bulunamadı.`);
                }
            }
        });



        // const popElement = document.getElementById("editPop_" + baseTableId);
        const popElement = document.getElementById("editPop_" + gridContainer.id.split('_')[1])
        if (popElement) {
            showPopup(popElement);
            firstInput.focus();
            firstInput.select();
        } else {
            console.warn("Uyarı: 'showPopup' fonksiyonu veya popup elementi tanımlı değil. ");
        }

    }



    function editRowClick(selectedRowLocal = null) {
        if (selectedRowLocal === null) {
            selectedRowLocal = selectedRow;
        }
        if (selectedRow === null & selectedRowLocal !== null)
        {
            selectedRow = selectedRowLocal;
            selectedRow.classList.add("selected");

        }

//        // Satırı seçili hale getir
//        clearAllSelections();
//        selectedRowLocal.classList.add("selected");
//        selectedRow = selectedRowLocal;



        // --- Server Side Update veya Popup ---
        let tableId = gridContainer.id;
        let table = document.getElementById(tableId);
        if (table.getAttribute("commandColumn")) {
            rowKeyValue = getCellData(selectedRowLocal, keyfield);
            editorsValues = getRowData(selectedRowLocal);
            const data = {
                tableName: gridContainer.id,
                action: 'UpdateOnServer',
                rowKeyValue: rowKeyValue,
                rowIndex: selectedRowLocal.id,
                rowData: editorsValues,
            };
            submitData("/tbgrid/dispatch.htm", data, null);
            return;
        }
        // eger rowediting aktif ise
        if (isEditableRow)
            startInlineEditing(selectedRowLocal);
        else
            editRow(selectedRowLocal);
    }

    function startInlineEditing(row) {
        if (inlineEditingRow && inlineEditingRow !== row) {
            cancelInlineEdit();
        }


        inlineOriginalData = getRowData(row);

        isupdateRow = true;
        inlineEditingRow = row;
        originalRowHTML = row.innerHTML;
        movedEditors = [];

        let baseTableId = gridContainer.id.replace("tbGridDiv_", "");
        const panelId = "editPopPanel_" + gridContainer.id;
        const panel = document.getElementById(panelId);

        if (!panel) {
            console.error("Editor paneli bulunamadı!");
            return;
        }
        firstInput = clearInputs();
        Array.from(row.cells).forEach(cell => {
            const dataColumnName = cell.getAttribute('data-columnname');

            // --- Action Kolonu ---
            if (cell.classList.contains("actions-column") || cell.id.includes("column_command")) {
                cell.innerHTML = `
                    <div class="action-buttons" style="display:flex; gap:5px; justify-content:center;">
                        <button type="button" class="action-button save-inline" title="Kaydet" style="color:green;">
                             <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                        </button>
                        <button type="button" class="action-button cancel-inline" title="İptal" style="color:red;">
                             <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                        </button>
                    </div>
                `;
                cell.querySelector(".save-inline").onclick = (e) => {
                    e.stopPropagation();
                    saveOrUpdateRow();
                };
                cell.querySelector(".cancel-inline").onclick = (e) => {
                    e.stopPropagation();
                    cancelInlineEdit();
                };
                return;
            }

            // --- Editörleri Taşıma ---
            if (dataColumnName) {
                const columnNameParts = dataColumnName.split('_');
                const actualColumnName = columnNameParts[0];
                const targetInputId = `tbGridEdit_${baseTableId + "_" + actualColumnName}`;


                const parentDivId = "div_" + targetInputId;
                const parentDiv = document.getElementById(parentDivId);

                // Editör değerini atayalım
                const inputElement = document.getElementById(targetInputId);
                if (inputElement) {
                    const cellText = cell.textContent.trim();
                    const columnVal = cell.getAttribute('data-columnvalue');
                    if (inputElement.type === "date")
                        inputElement.value = stringToDate(cellText);
                    else if (inputElement.type === "datetime-local")
                        inputElement.value = stringToDateTime(cellText);
                    else if (columnVal) {
                        inputElement.value = columnVal;
                        const vInput = document.getElementById(targetInputId + "_vi");
                        if (vInput)
                            vInput.value = cellText;
                    } else {
                        inputElement.value = cellText;
                    }
                }

                // Eğer wrapper div varsa içindekileri (Input + Butonlar vb) taşınıyor
                if (parentDiv) {
                    cell.innerHTML = "";
                    // Array.from önemli, çünkü appendChild yapınca liste değişir
                    Array.from(parentDiv.children).forEach(child => {
                        // Label hariç her şeyi al
                        if (child.tagName !== "LABEL") {
                            child.style.width = "100%";
                            child.style.boxSizing = "border-box";
                            if (child.tagName === "INPUT" || child.tagName === "SELECT") {
                                child.style.height = "26px";
                            }
                            cell.appendChild(child);

                            // Geri koymak için Parent ID ile kaydet
                            movedEditors.push({
                                element: child,
                                parentId: parentDivId
                            });
                        }
                    });
                }
                // Fallback: Wrapper div yoksa sadece inputu al (Eski yöntem)
                else if (inputElement) {
                    cell.innerHTML = "";
                    inputElement.style.width = "100%";
                    cell.appendChild(inputElement);
                    movedEditors.push({element: inputElement, parentId: panel.id});
                }
            }
        });


        if (firstInput)
            firstInput.focus();
    }

    function restoreInlineEditors() {
        if (movedEditors.length > 0) {
            movedEditors.forEach(item => {
                // 1. Stilleri temizle
                item.element.style.width = "";
                item.element.style.height = "";
                item.element.style.boxSizing = "";

                // 2. Doğru kapsayıcıyı (div_tbGridEdit...) bul ve içine koy
                const container = document.getElementById(item.parentId);
                if (container) {
                    container.appendChild(item.element);
                } else {
                    // Eğer kapsayıcı bulunamazsa (fallback) panele at
                    const panelId = "editPopPanel_" + gridContainer.id;
                    const panel = document.getElementById(panelId);
                    if (panel)
                        panel.appendChild(item.element);
                }
            });
            // Listeyi temizle
            movedEditors = [];
        }
    }

    function cancelInlineEdit() {
        if (!inlineEditingRow)
            return;

        // 1. Editörleri yerlerine geri koy
        restoreInlineEditors();

        // 2. HTML'i geri yükle (Sadece iptal işleminde)
        //if (inlineEditingRow.getAttribute("status") !== "updated") {
        inlineEditingRow.innerHTML = originalRowHTML;

        // Eventleri geri yükle
        inlineEditingRow.querySelectorAll('.action-button.edit').forEach(btn => {
            btn.onclick = function () {
                editRowClick(this.closest('tr'));
            };
        });
        inlineEditingRow.querySelectorAll('.action-button.delete').forEach(btn => {
            btn.onclick = function () {
                deleteRowClick(this.closest('tr'));
            };
        });
        //}

        inlineEditingRow = null;
        originalRowHTML = null;
        movedEditors = [];
        inlineOriginalData = null;
        isupdateRow = false;
    }


    function deleteRowClick(selectedRow)
    {
        let tableId = gridContainer.id;
        if (confirm('Silmek İstediğinizden Emin misiniz?') === false)
            return;
        rowKeyValue = getCellData(selectedRow, keyfield);
        editorsValues = getRowData(selectedRow);

        let actionCmd = "Delete"
        let table = document.getElementById(tableId);
        if (table.getAttribute("commandColumn"))
        {
            actionCmd = "DeleteOnServer"
        }

        const data = {
            tableName: gridContainer.id,
            action: actionCmd,
            rowKeyValue: rowKeyValue,
            rowIndex: selectedRow.id,
            rowData: editorsValues,
        };

        if (table.getAttribute("commandColumn"))
            submitData("/tbgrid/dispatch.htm", data, null);
        else
            submitData("/tbgrid/dispatch.htm", data, removeRow);

    }

    function insertRow()
    {
        editPopElement = document.getElementById("editPop_" + gridContainer.id.split('_')[1])
        isupdateRow = false;
        firstInput = clearInputs();
        showPopup(editPopElement);
        firstInput.focus();

    }

    function insertRowClick()
    {

        //close inline row editing
        if (inlineEditingRow)
        {
            cancelInlineEdit();
        }

        let tableId = gridContainer.id;
        let table = document.getElementById(tableId);
        if (table.getAttribute("commandColumn"))
        {
            rowKeyValue = getCellData(selectedRow, keyfield);
            editorsValues = getRowData(selectedRow);
            const data = {
                tableName: gridContainer.id,
                action: 'InsertOnServer',
                rowKeyValue: rowKeyValue,
                rowIndex: (selectedRow) ? selectedRow.id : "row_-1",
                rowData: editorsValues,
            };
            submitData("/tbgrid/dispatch.htm", data, null);

            return;
        }

        insertRow();
    }


    isupdateRow = true;

    async function handleContextAction(action) {

        const menuItem = contextMenu.querySelector(`li[data-action="${action}"]`);
        if (menuItem && menuItem.classList.contains('disabled')) {
            return;
        }

        await hideContextMenu();

        if (!selectedRow && ['edit', 'delete', 'details'].includes(action)) {
            console.warn(`handleContextAction: Action '${action}' requires a selected row.`);
            return;
        }

        switch (action) {
            case 'toggle-search':
                toggleSearchVisibility();
                break;
            case 'edit':
                //isupdateRow = true;
                //clearInputs();
                editRowClick(selectedRow)
                break;
            case 'insert':

                insertRowClick();
                break;
            case 'delete':
                if (selectedRow) {
                    deleteRowClick(selectedRow);
                }
                break;
            case 'details':
                //alert(keyfield);

                break;
            default:
                console.warn("Unknown context action:", action);
        }
    }

    function selectAllRows(event)
    {
        tableBody.querySelectorAll('input.select-row-checkbox').forEach(checkbox => {
            checkbox.checked = event.target.checked;
        });
    }

    function getSelectedRows() {
        //const selectedRows = tableBody.querySelectorAll('input.select-row-checkbox:checked');

        const selectedCheckboxes = tableBody.querySelectorAll('input.select-row-checkbox:checked');

        const selectedIds = Array.from(selectedCheckboxes).map(checkbox => comboGetLastSegment(checkbox.id));
        //console.log(selectedIds);
        return selectedIds;

    }

    function updateDeletedRowCount() {
        if (!tableBody)
            return;

        // Status'ü 'deleted' olan satırları bul
        const deletedRows = tableBody.querySelectorAll("tr[status='deleted']");
        const count = deletedRows.length;

        // Uyarı elementini bul veya oluştur
        let warningEl = gridContainer.querySelector('.deleted-row-warning');
        if (!warningEl) {
            warningEl = document.createElement('div');
            warningEl.className = 'deleted-row-warning';
            gridContainer.appendChild(warningEl);
        }

        // Sayı 0'dan büyükse göster, değilse gizle
        if (count > 0) {
            warningEl.textContent = `Silinen Kayıt Sayısı: ${count}`;
            warningEl.style.display = 'block';
        } else {
            warningEl.style.display = 'none';
        }
    }

    function applyEllipsisTooltips() {

        const table = tableBody;
        if (!table)
            return;

        const elements = table.querySelectorAll('td');

        elements.forEach(el => {

            if (!el.textContent.trim())
                return;

            if (el.querySelector('.action-buttons'))
                return;

            if (el.querySelector('.ellipsis-cell'))
                return;

            const text = el.textContent.trim();


            //  DOM render sonrası ölç
            requestAnimationFrame(() => {
                if (el.scrollWidth > el.clientWidth) {
                    el.setAttribute('title', text);
                }
            });
        });
    }

    function callWhenMeasured(fn, getEl, tries = 10) {
        const el = getEl();
        if (!el)
            return;

        const w = el.clientWidth;
        if (w > 0) {
            fn();
            return;
        }
        if (tries <= 0)
            return;

        requestAnimationFrame(() => callWhenMeasured(fn, getEl, tries - 1));
    }


    if (searchInput)
        searchInput.addEventListener("input", searchTable);
    if (clearBtn)
        clearBtn.addEventListener('click', clearSearch);
    if (exportXlsxBtn)
        exportXlsxBtn.addEventListener('click', exportExcel);
    if (selectAllCheckbox) {
        selectAllCheckbox.addEventListener('change', selectAllRows);
    }



    if (tableBody) {
        tableBody.addEventListener("click", (event) => {
            const row = event.target.closest('tr');
            if (!row)
                return;
            if (row.id === "empty_row")
                return;
            if (selectedRow === row)
                return;

            clearAllSelections();
            row.classList.add("selected");

            selectedRow = row;
            hideContextMenu();
            //close inline row editing
            if (inlineEditingRow)
                cancelInlineEdit();

        });

    }

    headers.forEach((th, idx) => {
        th.addEventListener("click", () =>
        {
            if (!th.id.includes("column_command") && !th.id.includes("column_check") && th.getAttribute("sorting"))
                sortTable(idx)
        });

    });

    if (contextMenu) {
        contextMenu.addEventListener('click', (event) => {
            const targetLi = event.target.closest('li');
            if (targetLi && targetLi.dataset.action) {
                handleContextAction(targetLi.dataset.action);
            }
        });
    }

    if (contextMenuItems && contextMenuItems.length > 0) {
        gridContainer.addEventListener("contextmenu", e => {
            e.preventDefault();


            const targetRow = e.target.closest('tr');

            const validRow = targetRow && tableBody && tableBody.contains(targetRow) ? targetRow : null;
            showContextMenu(e, validRow);
        });
    }
    //---------------------------------------------------------------
    const button = document.getElementById("popupEditingSave_" + gridContainer.id);
    if (button) {
        button.addEventListener("click", function () {
            saveOrUpdateRow();
        });

    }


    //updateRowCount();
    tableBody.querySelectorAll('.action-button.edit').forEach(button => {
        button.onclick = function () {
            editRowClick(this.closest('tr'));
        };
    });
    tableBody.querySelectorAll('.action-button.delete').forEach(button => {
        button.onclick = function () {
            deleteRowClick(this.closest('tr'));
        };
    });
    gridContainer.querySelectorAll('.action-button.insert').forEach(button => {
        button.onclick = function () {
            insertRowClick();
        };
    });
    function isVisible(row) {
        return row && row.offsetParent !== null;
    }

    tableBody.addEventListener('keydown', (event) => {


        // ENTER → satırı düzenleme
        if (event.key === "F2" && inlineEditingRow === null) {
            if (!selectedRow)
                return;


            editRowClick(selectedRow);
            event.preventDefault();
            return;
        }
        if (event.key === "F2" && inlineEditingRow) {
            if (inlineEditingRow) {

                let focusedInput = document.activeElement;
                //focusedInput.dispatchEvent(new Event('change', {bubbles: true}));
                //eger focuslanmıs nesnenin onchange inde bir islem varsa calissin diye.
                focusedInput.blur();
                focusedInput.focus();
                let inlineSaveBtn = document.querySelector(".action-button.save-inline");
                if (inlineSaveBtn) {

                    setTimeout(() => {
                        inlineSaveBtn.click();
                        tableBody.focus();
                    }, 100);
                }
                //tableBody.focus();
                event.preventDefault();
            }
            return;
        }

        if (event.key === "Escape" && inlineEditingRow)
        {
            cancelInlineEdit();
            tableBody.focus();
            event.preventDefault();
            return;
        }


        // YUKARI / AŞAĞI OK TUŞLARI
        if (event.key === "ArrowUp" || event.key === "ArrowDown") {
            if (!selectedRow)
                return;

            let targetRow = null;

            if (event.key === "ArrowUp") {
                targetRow = selectedRow.previousElementSibling;
                while (targetRow && !isVisible(targetRow)) {
                    targetRow = targetRow.previousElementSibling;
                }
            } else if (event.key === "ArrowDown") {
                targetRow = selectedRow.nextElementSibling;
                while (targetRow && !isVisible(targetRow)) {
                    targetRow = targetRow.nextElementSibling;
                }
            }

            // boş satıra gitmeyi engelle
            if (targetRow && targetRow.id === "empty_row") {
                event.preventDefault();
                return;
            }

            if (targetRow) {
                clearAllSelections();
                targetRow.classList.add("selected");
                selectedRow = targetRow;
                hideContextMenu();

                if (inlineEditingRow)
                {
                    cancelInlineEdit();
                    tableBody.focus();
                }

                // SCROLL SELECTED ROW INTO VIEW
                selectedRow.scrollIntoView({
                    behavior: "auto",
                    block: "nearest"
                });
                event.preventDefault();
            }
        }
//        if (searchContainer && searchContainer.style.display === 'none' && event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) {
//            toggleSearchVisibility();
//            searchInput.value = event.key;
//            searchInput.focus();
//            searchInput.selectionStart = searchInput.selectionEnd = searchInput.value.length;
//            searchTable();
//            clearAllSelections();
//            event.preventDefault();
//        }
    });

    updateFooterSummaries();
    callWhenMeasured(
            () => applyEllipsisTooltips(),
            () => tableWrapper
    );
    //applyEllipsisTooltips();


    if (filterText && filterText !== "")
    {
        filterTable(filterText);
    }

    return {
        getID: () => {
            return gridContainer.id;
        },
        getSelectedRow: () => {
            return selectedRow;
        },
        clearSelection: () => {
            selectedRow = null;
        }
        ,
        getSelectedRows: () => {
            return getSelectedRows();
        }
        ,
        getSelectedRowColumnValue: (columnname) => {
            return getCellData(selectedRow, columnname);
        }
        ,
        refresh: (args = null) =>
        {
            loadedRows = 0;
            isLoading = false;
            loadMoreRecords(args);
        }
        ,
        getRowDataAsJSON: () =>
        {
            return getRowData(selectedRow);
        }
        ,
        getGridEditorsData: () =>
        {
            return getGridEditorsData()
        }
        ,
        insertRow: () =>
        {
            insertRow()
        }
        ,
        deleteRow: () =>
        {
//            selectedRow.remove();            
//            selectedRow = null;
//            updateFooterSummaries();
            removeSelectedRow();

        }
        ,
        editRow: () =>
        {
            //editRow(selectedRow);
            if (isEditableRow)
                startInlineEditing(selectedRow);
            else
                editRow(selectedRow);
        }
        ,
        setEnable: (value) =>
        {
            tableBody.querySelectorAll('.action-button.edit').forEach(button => {
                button.disabled = value;
            });
            tableBody.querySelectorAll('.action-button.delete').forEach(button => {
                button.disabled = value;
            });
            gridContainer.querySelectorAll('.action-button.insert').forEach(button => {
                button.disabled = value;
            });
        }
        ,
        isEditable: () =>
        {
            return isEditable;
        }
        ,
        isRowEditing: () =>
        {
            if (inlineEditingRow)
            {
                return true;
            }
            return false;
        }
        ,
        filterTable: (filterText = null) =>
        {

            filterTable(filterText);
        }

    };



}

