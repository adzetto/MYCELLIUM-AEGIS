//-----------------global--------------------------------

function getParentPageName(elOrId) {
    const el = (typeof elOrId === "string") ? document.getElementById(elOrId) : elOrId;
    if (!el)
        return null;

    // En yakın page container: id="page_<name>"
    const pageEl = el.closest('[id^="page_"]');
    if (!pageEl || !pageEl.id)
        return null;

    // "page_" prefix'ini at
    return pageEl.id.substring("page_".length);
}

function getParentPanelName(elOrId) {
    const el = (typeof elOrId === "string") ? document.getElementById(elOrId) : elOrId;
    if (!el)
        return null;

    const panelEl = el.closest(".panel"); // 1 üst panel (en yakın)
    return panelEl ? panelEl.id : null;
}

function addLoadEvent(func) {
    window.addEventListener("load", (event) => {
        func();
    });
}

function setPopupStateOnLoad(popElementName)
{
    addLoadEvent(function () {
        const popupState = sessionStorage.getItem(popElementName);
        if (popupState !== null && popupState !== "none") {
            showPopup(document.getElementById(popElementName));
        }
    });
}

function handleServerResponse(updated) {
    updated = updated.responseAction;
    // 1) Dialoglar
    if (Array.isArray(updated.dialogs)) {
        updated.dialogs.forEach(d => {
            let activeElement = document.activeElement;

            if (d.type === "info")
                alert(d.text);
            else if (d.type === "yesNo")
            {
                let result = confirm(d.text);
                const data = {
                    result: result,
                    dialogID: d.dialogID,
                };
                submitData("/tbdialog/dispatch.htm", data, null);

            }

            if (activeElement)
            {
                try {
                    activeElement.focus();
                } catch (error) {
                }
            }

        });
    }

    // 2) Actions
    if (Array.isArray(updated.actions)) {
        updated.actions.forEach(a => {
            switch (a.type) {
                case "gridRefresh":
                    var grid = window[a.targetID];
                    if (grid)
                        grid.refresh(a.args);
                    break;
                case "gridInsert":
                    var grid = window[a.targetID];
                    if (grid)
                        grid.insertRow();
                    break;
                case "gridDelete":
                    var grid = window[a.targetID];
                    if (grid)
                        grid.deleteRow();
                    break;
                case "gridEdit":
                    var grid = window[a.targetID];
                    if (grid)
                        grid.editRow();
                    break;
                case "setEnable":
                    var element = document.getElementById(a.targetID);

                    if (element && (element.getAttribute("editortype") === "COMBOBOX" || element.getAttribute("editortype") === "CURRENCY"))
                    {
                        if (element.getAttribute("editortype") === "COMBOBOX")
                        {
                            var toogleButton = document.getElementById(a.targetID + "_toggleButton");
                            toogleButton.disabled = (a.value === false || a.value === "false");
                        }
                        element = document.getElementById(a.targetID + "_vi");
                    }
                    if (element.id.includes("tbGrid") && !element.id.includes("tbGridEdit"))//grid
                    {
                        var grid = window[a.targetID.split('_')[1] ];
                        if (grid)
                            grid.setEnable((a.value === false || a.value === "false"));
                    } else
                        element.disabled = (a.value === false || a.value === "false");

                    break;

                case "setValue":
                    var element = document.getElementById(a.targetID);
                    if (element.getAttribute("editortype") === "CURRENCY")//currency editor
                    {
                        element.value = a.value;
                        setMoneyValue(a.targetID + "_vi", a.value);

                    } else if (element.getAttribute("editortype") === "COMBOBOX")
                    {
                        const parts = a.split(':');
                        element.value = parts[0];
                        visualElement = document.getElementById(a.targetID + "_vi");
                        visualElement.value = part[1];
                    } else
                    {
                        element.value = a.value;
                    }

                    break;
                case "setPanelHtml":
                    var panelContent = document.getElementById("pnlContent_" + a.targetID);
                    panelContent.innerHTML = a.value;
                    break;
                case "callFunction":
                    if (typeof window[a.functionName] === "function") {
                        window[a.functionName](...(a.args || []));
                    }
                    break;
            }
        });
    }

    // 3) Redirect
    if (updated.redirect) {
        setTimeout(() => {
            window.location.href = updated.redirect.url;
        }, updated.redirect.delay || 0);
    }
    if (updated.download) {
        const iframe = document.createElement("iframe");
        iframe.style.display = "none";
        iframe.src = updated.download.url;
        document.body.appendChild(iframe);

        let cleanedUp = false;

        const cleanup = () => {
            if (cleanedUp)
                return;
            cleanedUp = true;

            iframe.remove();
            if (updated.download.refreshAfter === true) {
                window.location.reload();
            }
        };


        setTimeout(cleanup, updated.download.delay || 500);

        // bazı tarayıcılarda çalışır
        iframe.onload = () => {
            setTimeout(cleanup, 300);
        };
    }
    if (updated.refreshPage) {
        setTimeout(() => {
            window.location.reload();
        }, updated.refreshPage.delay || 0);
    }


}

function messageDialog(message, messageDialog)
{
    if (messageDialog === "info")
        alert(message);
    if (messageDialog === "yesNo")
        confirm(message);
}

//-------loading PAnel-----------
function showLoading(targetId = null) {
    var overlay = document.getElementById('loadingOverlay');

    if (targetId) {

        var targetElement = document.getElementById(targetId);
        if (targetElement) {

            if (getComputedStyle(targetElement).position === 'static') {
                targetElement.style.position = 'relative';
            }

            overlay.style.position = 'absolute';
            targetElement.appendChild(overlay);
        }
    } else {
        // Tüm ekranı kapla (Varsayılan)
        if (overlay) {
            overlay.style.position = 'fixed';
            document.body.appendChild(overlay);
        }
    }

    if (overlay)
        overlay.style.display = 'flex';

}


function hideLoading() {
    var overlay = document.getElementById('loadingOverlay');
    if (overlay) {
        overlay.style.display = 'none';

        document.body.appendChild(overlay);
    }

}
//-------------------------------

function submitData(link, data, onSuccess) {
    showLoading();
    fetch(link, {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify(data)
    }).then(res => {

        if (!res.ok) {
            return res.json().then(errData => {
                const error = {
                    status: res.status,
                    message: errData.message || "Sunucudan hata döndü"
                };
                throw error;
            });
        }

        return res.json();
    }).then(updated => {

        if (typeof onSuccess === "function") {
            onSuccess(updated);
        }

        if (updated.responseAction) {
            hideLoading();
            handleServerResponse(updated);
        }



    }).catch(err => {
        console.error("Hata:", err);
        hideLoading();

        if (err.status) {
            switch (err.status) {
                case 400:
                    alert("400 - Geçersiz istek: " + err.message);
                    break;
                case 404:
                    alert("404 - Kaynak bulunamadı.");
                    break;
                case 500:
                    alert("500 - Sunucu hatası.");
                    break;
                default:
                    alert(err.status + " - Hata: " + err.message);
            }
        } else {
            // Network hataları buraya gelir
            alert("Bağlantı hatası: " + err);
        }
    }).finally(() => {

    });
}

