function getInputLabelbyID(inputID)
{
    let inp = document.getElementById('label_' + inputID);
    return inp.innerText.replace("*", "");
}

function validateFormInputs(container = null) {
    // Container belirtilmişse onun içindeki inputları, yoksa tüm document'i tara
    const requiredInputs = container
            ? container.querySelectorAll('input[required], textarea[required], select[required], input[min], input[max], input[type="email"], input[type="number"], input[pattern]')
            : document.querySelectorAll('input[required], textarea[required], select[required], input[min], input[max], input[type="email"], input[type="number"], input[pattern]');

    let isValid = true;
    let errorMessages = [];

    // Her input için tarayıcı doğrulamasını kontrol et
    requiredInputs.forEach(input => {
        // checkValidity ile tarayıcı doğrulamasını çalıştır
        if (!input.checkValidity()) {
            isValid = false;
            // Hata mesajını input'un validationMessage özelliğinden al
            errorMessages.push((input.validationMessage || `${ getInputLabelbyID(input.id) || 'Bir alan'} geçersiz!`) + '(' + getInputLabelbyID(input.id) + ')');
            input.classList.add('error'); // Görsel feedback
        } else {
            input.classList.remove('error'); // Hata yoksa sınıfı kaldır
        }
    });

    // Hatalar varsa kullanıcıyı bilgilendir
    if (!isValid) {
        alert(errorMessages.join('\n')); // Hataları birleştir ve göster
        return false;
    }

    return true;
}

function getFormDataAsJson(elementName) {
    //const form = document.getElementById('page_' + pageName);
    const form = document.getElementById(elementName);

    //const form = document.getElementsByClassName("tbpage-container");

    if (!form) {
        console.error('Form with ID maintab not found.');
        return null;
    }

    const formData = {};
    const inputs = form.querySelectorAll('input, select, textarea');

    inputs.forEach(input => {

        if (input.type === 'button' || input.type === 'submit' || input.id.startsWith('tbGridEdit_') || input.id.startsWith('tbgrid_check_')) {
            return;
        }

        const name = input.id || input.name;
        if (name) {
            if (input.type === 'checkbox') {
                formData[name] = input.checked;
            } else if (input.type === 'radio') {
                if (input.checked) {
                    formData[name] = input.value;
                }
            } else {
                formData[name] = input.value;
            }
        }
    });



    const grids = form.querySelectorAll(".tbGrid");
    const formGrids = {};
    grids.forEach(grid => {
        if (grid && grid.getAttribute("rowediting") === "true") {

            const gridData = [];
            const tbody = grid.querySelector("tbody");
            const rows = tbody.querySelectorAll('tr');

            const columnHeaderMap = new Map();
            grid.querySelectorAll('thead th').forEach((th, index) => {
                if (th.id) {
                    const idParts = th.id.split('_');
                    const columnName = idParts[idParts.length - 1];
                    columnHeaderMap.set(index, columnName);
                }
            });

            rows.forEach(row => {
                //if (row.id !== 'empty_row' && row.getAttribute('status'))
                if (row.id !== 'empty_row')
                {
                    const rowData = {};
                    const cells = row.querySelectorAll('td, th');
                    colIndex = 0;
                    rowData['rowIndex'] = row.id.split('_')[1];
                    rowData['status'] = row.getAttribute('status');
                    cells.forEach((cell, index) => {
                        const colName = columnHeaderMap.get(index);
                        if (colName !== 'command' && colName !== 'check')
                        {
                            //if (cell.style.backgroundColor)//updated or inserted
                            //{
                            //eger nesne combobox ise
                            if (cell.getAttribute('data-columnvalue'))
                                rowData[colName] = cell.getAttribute('data-columnvalue');
                            else
                                rowData[colName] = cell.textContent.trim();
                            //}
                            colIndex++;
                        }


                    });

                    gridData.push(rowData);
                }
            });
            const gridName = grid.id.split('_')[1];
            formGrids[gridName] = gridData;
            ;


        }
    });
    formData["grids"] = formGrids;


    return formData;
}

let formSnapshots = {};

function takeAllPagesSnapshots() {
    // ID'si "page_" ile başlayan tüm elementleri seç
    const pageElements = document.querySelectorAll('[id^="page_"]');

    pageElements.forEach(el => {
        const pageId = el.id;
        const data = getFormDataAsJson(pageId);
        if (data) {
            formSnapshots[pageId] = JSON.stringify(data);
            console.log("Snapshot alındı: " + pageId);
        }
    });
}

function isPageModified(pageId) {
    if (!formSnapshots[pageId])
        return false;
    const currentData = JSON.stringify(getFormDataAsJson(pageId));
    return formSnapshots[pageId] !== currentData;
}

function isPageChanged(pageId) {
    return isPageModified('page_' + pageId);
}

addLoadEvent(function () {
    setTimeout(() => takeAllPagesSnapshots(), 400);
});

function confirmIfDirty(pageId, actionCallback) {
    if (isPageModified(pageId)) {
        if (confirm("Değişiklik yaptınız. Kaydetmeden çıkmak istediğinize emin misiniz?")) {
            actionCallback();
        }
    } else {
        actionCallback();
    }
}

function closePage(PageName)
{
    const pageId = 'page_' + PageName;
    confirmIfDirty(pageId, () => {
        const jsonData = getFormDataAsJson(pageId);
        let isPageChanged = isPageModified(pageId);
        const data = {
            pageName: PageName,
            action: 'Close',
            pageInputs: jsonData,
            isPageChanged: isPageChanged,
            recordIndex: 0,
        };
        submitData("/tbpage/dispatch.htm", data, null);
    });
}


function newPage(PageName)
{
    const pageId = 'page_' + PageName;
    confirmIfDirty(pageId, () => {
        const jsonData = getFormDataAsJson(pageId);
        let isPageChanged = isPageModified(pageId);
        const data = {
            pageName: PageName,
            action: 'New',
            pageInputs: jsonData,
            isPageChanged: isPageChanged,
            recordIndex: 0,
        };

        submitData("/tbpage/dispatch.htm", data, (response) => {
            const url = new URL(window.location.href);
            url.searchParams.set("ID", "0");
            window.history.pushState({}, "", url);

        });
    });
}

function deletePage(PageName)
{

    const pageId = 'page_' + PageName;
    const jsonData = getFormDataAsJson(pageId);
    let isPageChanged = isPageModified(pageId);
    const data = {
        pageName: PageName,
        action: 'Delete',
        pageInputs: jsonData,
        isPageChanged: isPageChanged,
        recordIndex: 0,
    };

    submitData("/tbpage/dispatch.htm", data, null);
}



function gobackPage(PageName, timeout)
{
    const pageId = 'page_' + PageName;
    confirmIfDirty(pageId, () => {
        if (timeout > 0) {
            const sessionData = {
                responseAction: {refreshPage: {delay: timeout}}
            };
            sessionSetCommand(sessionData);
        }
        history.back();
    });

}

function desingPage(PageName)
{
    showPopup(desingPage);
//    const jsonData = getFormDataAsJson('page_' + PageName);
//
//    const data = {
//        pageName: PageName,
//        action: 'Delete',
//        pageInputs: jsonData,
//        recordIndex: 0,
//    };
//
//    submitData("/tbpage/dispatch.htm", data, null);
}

function savePage(PageName)
{
    const pageId = 'page_' + PageName;
    if (validateFormInputs())
    {
        const jsonData = getFormDataAsJson(pageId);
        let isPageChanged = isPageModified(pageId);
        const data = {
            pageName: PageName,
            action: 'Save',
            pageInputs: jsonData,
            isPageChanged: isPageChanged,
            recordIndex: 0,
        };

        submitData("/tbpage/dispatch.htm", data, (response) => {
//            const data = getFormDataAsJson(pageId);
//            if (data && response.result) {
//                formSnapshots[pageId] = JSON.stringify(data);
//            }
            takeAllPagesSnapshots();
        });
    }

}

function refreshPanel(panel, args = null)
{
    if (validateFormInputs())
    {
        const jsonData = getFormDataAsJson(panel.id);
        let parentPageId = getParentPageName(panel);
        let isPageChanged = isPageModified(parentPageId);

        const data = {
            panelName: panel.id,
            action: 'Refresh',
            panelInputs: jsonData,
            isPageChanged: isPageChanged,
            recordIndex: 0,
            args: args,
        };

        submitData("/tbpanel/dispatch.htm", data, null);
}

}

function sessionSetCommand(command) {
    try {
        sessionStorage.setItem("SessionCommand", JSON.stringify(command));
    } catch (e) {
        console.error("SessionCommand kaydedilemedi:", e);
    }
}

function sessionClearCommand() {
    try {
        sessionStorage.removeItem("SessionCommand");
    } catch (e) {

    }
}

function sessionGetCommand() {
    const item = sessionStorage.getItem("SessionCommand");
    if (!item)
        return null;
    sessionClearCommand();
    try {
        return JSON.parse(item);
    } catch (e) {
        console.error("SessionCommand okunamadı:", e);
        return null;
    }
}

window.addEventListener("pageshow", function (event) {
    if (event.persisted) {
        // window.location.reload();
        sessionCommand = sessionGetCommand();
        if (sessionCommand)
        {
            handleServerResponse(sessionCommand);
        }
    }
});
