
class tbIFrameElement {
    constructor(popElementName, iframeUrl, iframeStyle) {
        this.popElementName = popElementName;
        this.iframeUrl = iframeUrl;
        this.iframeStyle = iframeStyle;
    }
}


class tbIFrameManager {
    constructor() {
        this.elements = [];
    }

    addElement(popElementName, iframeUrl, iframeStyle = null) {
        const newElement = new tbIFrameElement(popElementName, iframeUrl, iframeStyle);
        this.elements.push(newElement);

    }

    removeElement(popElementName) {
        const initialLength = this.elements.length;
        this.elements = this.elements.filter(el => el.popElementName !== popElementName);
        if (this.elements.length < initialLength) {
            console.log(`Element silindi: ${popElementName}`);
        } else {
            console.log(`Element bulunamadı: ${popElementName}`);
        }
    }

    getElements() {
        return  this.elements;
    }

    findElementByName(popElementName) {
        const foundElement = this.elements.find(el => el.popElementName === popElementName);
        if (foundElement) {
            return foundElement;
        } else {
            return null;
        }
    }
}

const iframeManager = new tbIFrameManager();

function messageText(text, sender = null)
{
    var senderText = "";
    if (sender === null)
        senderText = "Sender is null";
    else
        senderText = "Sender id=" + sender.id;
    alert("text:" + text + " / " + senderText);
}

function showHide(itemId, show = null) {
    var item = document.getElementById(itemId);
    if (item === null) {
        return;
    }

    if (show === null) { // Eğer show belirtilmemişse
        item.style.display = (item.style.display === 'none') ? "" : "none";
    } else if (show) {
        item.style.display = "";
    } else {
        item.style.display = "none";
}
}


function togglePanel(button, content, collapse = null) {
    const isCurrentlyHidden = content.style.display === 'none' || content.style.display === '';

    if (collapse === true) {
        // Zorla kapat
        content.style.display = 'none';
        button.classList.remove('open');
        sessionStorage.setItem(button.id, "collapsed");
    } else if (collapse === false) {
        // Zorla aç
        content.style.display = 'block';
        button.classList.add('open');
        sessionStorage.setItem(button.id, "expanded");
    } else {
        // Mevcut duruma göre toggle
        if (isCurrentlyHidden) {
            content.style.display = 'block';
            button.classList.add('open');
            sessionStorage.setItem(button.id, "expanded");
        } else {
            content.style.display = 'none';
            button.classList.remove('open');
            sessionStorage.setItem(button.id, "collapsed");
        }
}
}

function setPanelExpandStateOnLoad(panelName)
{
    addLoadEvent(function () {
        var btn = document.getElementById("pnlButton_" + panelName);
        if (btn === null)
            return;
        var panelContent = document.getElementById("pnlContent_" + panelName);

        const ExpandState = sessionStorage.getItem(btn.id);
        if (ExpandState !== null) {
            if (ExpandState === "collapsed") {
                togglePanel(btn, panelContent, true);
            } else
                togglePanel(btn, panelContent, false);
        }
    }
    );
}

function cancel() {
    return false;
}


function disableDivItems(divID, enable) {
    divID.disabled = true;
    var nodes = divID.getElementsByTagName('*');
    //console.log(nodes);
    for (var i = 0; i < nodes.length; i++) {
        if (!enable) {
            nodes[i].setAttribute('disabled', true);
            // nodes[i].onclick = cancel;
            if ((nodes[i].tagName === 'INPUT' && (nodes[i].type === 'text' || nodes[i].type === 'password'
                    || nodes[i].type === 'number' || nodes[i].type === 'date'
                    || nodes[i].type === 'datetime-local' || nodes[i].type === 'email'
                    || nodes[i].type === 'file' || nodes[i].type === 'image'
                    || nodes[i].type === 'password' || nodes[i].type === 'tel'
                    || nodes[i].type === 'time' || nodes[i].type === 'url'
                    || nodes[i].type === 'week'
                    )) || nodes[i].tagName === "TEXTAREA") {
                nodes[i].value = null;
            }
            if (nodes[i].tagName === 'INPUT' && (nodes[i].type === 'radio' || nodes[i].type === 'checkbox')) {
                nodes[i].checked = false;
            }
        } else
        {
            nodes[i].removeAttribute('disabled');
            // nodes[i].onclick = null;
        }

    }
}

function dragElement(elmnt) {
    var pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
    if (document.getElementById(elmnt.id + "header")) {
        document.getElementById(elmnt.id + "header").onmousedown = dragMouseDown;
    } else {
        elmnt.onmousedown = dragMouseDown;
    }

    function dragMouseDown(e) {
        e = e || window.event;
        e.preventDefault();

        pos3 = e.clientX;
        pos4 = e.clientY;
        document.onmouseup = closeDragElement;

        document.onmousemove = elementDrag;
    }

    function elementDrag(e) {
        e = e || window.event;
        e.preventDefault();

        pos1 = pos3 - e.clientX;
        pos2 = pos4 - e.clientY;
        pos3 = e.clientX;
        pos4 = e.clientY;

        elmnt.style.top = (elmnt.offsetTop - pos2) + "px";
        elmnt.style.left = (elmnt.offsetLeft - pos1) + "px";
    }

    function closeDragElement() {

        document.onmouseup = null;
        document.onmousemove = null;
    }
}

function showPopup(popElement, iframeUrl = null, iframeStyle = null)
{
    if (iframeUrl === null)//calling from jsp
    {
        iframe = iframeManager.findElementByName(popElement.id);
        if (iframe)
            createIFrame(popElement, iframe.iframeUrl, iframe.iframeStyle);
    } else//call from javascript
        createIFrame(popElement, iframeUrl, iframeStyle);

    popElement.style.display = "flex";

    if (popElement.getAttribute("closeClickOnForm"))
    {
        function outsideClickHandler(event) {
            if (popElement.className === "popupModal")
            {
                if (event.target === popElement) {
                    hidePopup(popElement);

                }
            } else
            {
                if (!popElement.contains(event.target)) {
                    hidePopup(popElement);

                }
            }
            window.removeEventListener("click", outsideClickHandler);
        }

        // Bir sonraki event loop’ta dinlemeye başla
        setTimeout(() => {
            window.addEventListener("click", outsideClickHandler);
        }, 0);
    }


    sessionStorage.setItem(popElement.id, "flex");

}


function showPopupUnderObject(buttonElement, popupElement) {
    const rect = buttonElement.getBoundingClientRect();
    const scrollTop = window.pageYOffset || document.body.scrollTop;
    const scrollLeft = window.pageXOffset || document.body.scrollLeft;

    popupElement.style.visibility = "hidden";
    popupElement.style.display = "block";

    const popupWidth = popupElement.offsetWidth;
    const popupHeight = popupElement.offsetHeight;

    const spaceBelow = window.innerHeight - rect.bottom;
    const isEnoughSpaceBelow = spaceBelow >= popupHeight;


    popupElement.style.position = "fixed";
    popupElement.style.left = ((popupWidth / 2) + (rect.left)) + "px";

    if (isEnoughSpaceBelow) {
        popupElement.style.top = ((popupHeight / 2) + rect.bottom) + "px";
    } else {

        popupElement.style.top = ((rect.top - (popupHeight / 2))) + "px";
    }

    popupElement.style.display = "flex";
    popupElement.style.visibility = "visible";


    showPopup(popupElement);
}

function hidePopup(popElement)
{
    popElement.style.display = "none";

    sessionStorage.setItem(popElement.id, "none");
    removeIFrame(popElement);
}




function createIFrame(parentElement, iframeURL, iframeStyle = null)
{
    const iframe = document.createElement('iframe');

    iframe.src = iframeURL;
    iframe.style = iframeStyle;
    iframe.id = "iframe_" + parentElement.id;
    popcontent = document.getElementById('pnlContent_' + parentElement.id);
    popcontent.appendChild(iframe);
}

function removeIFrame(parentElement) {

    const iframes = parentElement.querySelectorAll('iframe');
    if (iframes) {
        popcontent = document.getElementById('pnlContent_' + parentElement.id);
        iframes.forEach(iframe => {
            popcontent.removeChild(iframe);
        });
    }

}

function setMoneyValue(visibleId, doubleValue) {
    const visibleInput = document.getElementById(visibleId);

    const maxDecimals = parseInt(visibleInput.getAttribute('decimalPart')) || 2;
    const useSep = visibleInput.getAttribute('useThousandSeparator') !== 'false';

    const intPart = Math.floor(doubleValue);
    const decPart = (doubleValue - intPart).toFixed(maxDecimals);
    const decStr = decPart.split('.')[1] || '0'.repeat(maxDecimals);

    const formattedInt = useSep ? intPart.toLocaleString('tr-TR') : intPart.toString();

    visibleInput.value = formattedInt + ',' + decStr;
}

function formatMoneyInput(input) {
    const hiddenInput = document.getElementById(comboGetPrefix(input.id));

    // Değişiklik 1: Regex'e "-" işaretini ekledik
    let value = input.value.replace(/[^0-9,-]/g, '');

    if (value === '' || value === '-') {
        input.value = value; // Kullanıcı sadece "-" yazabilsin diye
        hiddenInput.value = '0';
        return;
    }

    // Negatiflik kontrolü
    const isNegative = value.startsWith('-');
    const parts = value.split(',');
    let integerPart = parts[0] || '0';
    let decimalPart = parts[1] || '';


    integerPart = integerPart.replace(/[^0-9]/g, '');
    if (integerPart === '')
        integerPart = '0';

    const intValue = parseInt(integerPart) || 0;
    const useThousandSeparator = input.getAttribute('useThousandSeparator') !== 'false';
    let formattedInteger = useThousandSeparator ? intValue.toLocaleString('tr-TR').split(',')[0] : intValue.toString();

    // Negatif ise başına ekle
    if (isNegative && intValue !== 0) {
        formattedInteger = '-' + formattedInteger;
    }

    const maxDecimals = parseInt(input.getAttribute('decimalPart')) || 2;
    decimalPart = decimalPart.replace(/[^0-9]/g, '').slice(0, maxDecimals);

    let formatted = formattedInteger;
    if (value.includes(',')) {
        formatted += ',' + decimalPart;
    }

    // Hidden input için hesaplama (Double formatı)
    let doubleValue = intValue;
    if (decimalPart) {
        doubleValue += parseInt(decimalPart.padEnd(maxDecimals, '0')) / Math.pow(10, maxDecimals);
    }

    // Değişiklik 3: Hidden input değerini negatifse eksi ile çarp
    if (isNegative)
        doubleValue = -doubleValue;

    hiddenInput.value = doubleValue.toFixed(maxDecimals);
    input.value = formatted;
}

