//---------------------------TAB------------------------------
function initializeTab(containerId, defaultIndex = 0) {
    const container = document.getElementById(containerId);
    if (!container)
        return;

    const buttons = container.querySelectorAll('.tab-btn');
    const contents = container.querySelectorAll('.tab-content');
    const loader = container.querySelector('.tab-loader');

    const toggleLoader = (show) => {
        if (loader)
            loader.classList.toggle('show', show);
    };


    const handleTabClick = async (event) => {
        const btn = event.currentTarget;
        const targetId = btn.getAttribute('data-target');
        const targetContent = container.querySelector(`#${targetId}`);

        // UI Temizle
        buttons.forEach(b => b.classList.remove('active'));
        contents.forEach(c => c.classList.remove('active'));

        // Aktif Et
        btn.classList.add('active');
        if (targetContent)
            targetContent.classList.add('active');

        // Dinamik İçerik Kontrolü
        const fetchUrl = btn.getAttribute('data-url');
        if (fetchUrl && targetContent) {
            // İçerik zaten varsa tekrar yükleme (İsteğe bağlı)
            if (targetContent.innerHTML.trim() !== "")
                return;

            try {
                toggleLoader(true);
                const params = btn.getAttribute('data-params') ? JSON.parse(btn.getAttribute('data-params')) : {};


                const html = "SubmitData Eklenecek";
                targetContent.innerHTML = html;
            } catch (error) {
                targetContent.innerHTML = "Hata oluştu.";
            } finally {
                toggleLoader(false);
            }
        }
    };

    buttons.forEach(btn => {
        btn.addEventListener('click', handleTabClick);
    });

    // BAŞLANGIÇ TABINI AÇMA MANTIĞI
    if (buttons[defaultIndex]) {
        buttons[defaultIndex].click();
}
}


